#!/usr/bin/env bash
# AI_DEV_LAUNCHER_V1
set -euo pipefail
script_path="${BASH_SOURCE[0]:-$0}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" = /* ]] || script_path="$script_dir/$script_path"
done
script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
repo_root="$(cd "$script_dir/../../../.." && pwd)"
source "$repo_root/tools/bootstrap/python_select.sh"
python_executable="$(ai_dev_select_python "flow-report")" || exit 1
export FLOW_COMMAND_NAME="flow-report"
export PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}"
exec "$python_executable" -m ai_dev_flow.cli __ai_dev_flow_exec__ report "$@"
