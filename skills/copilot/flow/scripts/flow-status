#!/usr/bin/env bash
# AI_DEV_LAUNCHER_V1
set -euo pipefail

script_path=""
if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
  script_path="${BASH_SOURCE[0]}"
else
  script_path="$0"
fi

while [[ -L "$script_path" ]]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  if [[ "$script_path" != /* ]]; then
    script_path="$script_dir/$script_path"
  fi
done

script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
repo_root="$(cd "$script_dir/../../../.." && pwd)"
source "$repo_root/tools/bootstrap/python_select.sh"

python_executable="$(ai_dev_select_python "flow-status")" || exit 1
flow_command_name="$(basename "$0")"
export FLOW_COMMAND_NAME="$flow_command_name"

if [[ -n "${PYTHONPATH:-}" ]]; then
  PYTHONPATH="$repo_root:$PYTHONPATH"
else
  PYTHONPATH="$repo_root"
fi
export PYTHONPATH

exec "$python_executable" -m ai_dev_flow.cli "__ai_dev_flow_exec__" "status" "$@"
