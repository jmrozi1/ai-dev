#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]:-$0}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" = /* ]] || script_path="$script_dir/$script_path"
done

script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
flow_helper="$(cd "$script_dir/../../flow/scripts" && pwd -P)/flow-report"

if [[ ! -x "$flow_helper" ]]; then
  echo "error: missing sibling Flow helper at $flow_helper; repair the installed skill layout" >&2
  exit 1
fi

exec "$flow_helper" "$@"
