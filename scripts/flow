#!/bin/sh
set -eu

script_path=$0
case "$script_path" in
	/*) : ;;
	*/*) script_path="$PWD/$script_path" ;;
	*)
		resolved_path=$(command -v -- "$script_path" 2>/dev/null || printf '%s' "$script_path")
		case "$resolved_path" in
			/*) script_path="$resolved_path" ;;
			*) script_path="$PWD/$resolved_path" ;;
		esac
		;;
esac

if command -v readlink >/dev/null 2>&1; then
	while [ -h "$script_path" ]; do
		script_dir_part=${script_path%/*}
		[ "$script_dir_part" = "$script_path" ] && script_dir_part=.
		script_directory=$(CDPATH= cd -- "$script_dir_part" && pwd)
		link_target=$(readlink "$script_path")
		case "$link_target" in
			/*) script_path=$link_target ;;
			*) script_path=$script_directory/$link_target ;;
		esac
	done
fi

script_dir_part=${script_path%/*}
[ "$script_dir_part" = "$script_path" ] && script_dir_part=.
script_directory=$(CDPATH= cd -- "$script_dir_part" && pwd)
repository_root=$(CDPATH= cd -- "$script_directory/.." && pwd)

invoked_name=${0##*/}
FLOW_COMMAND_NAME=${FLOW_COMMAND_NAME:-$invoked_name}
export FLOW_COMMAND_NAME

if [ -n "${PYTHONPATH:-}" ]; then
	PYTHONPATH=${repository_root}:${PYTHONPATH}
else
	PYTHONPATH=${repository_root}
fi
export PYTHONPATH

if command -v python3 >/dev/null 2>&1; then
	exec python3 -m ai_dev_flow.cli "$@"
fi

if command -v python >/dev/null 2>&1; then
	exec python -m ai_dev_flow.cli "$@"
fi

printf 'flow: Python 3 is required but was not found on PATH.\n' >&2
exit 1